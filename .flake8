[flake8]
exclude =
    .git,
    __pycache__,
    build,
    dist,
    docs/source/conf.py
max-line-length = 115
# Ignore some style 'errors' produced while formatting by 'black'
ignore = E203, W503
# Hand-aligned neighborhood tables are kept with '# fmt: off'
per-file-ignores =
    lattics/_kernels/lattice.py: E201, E231, E241
